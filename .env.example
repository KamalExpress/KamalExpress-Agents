# ─────────────────────────────────────────────
# AI SERVICE PROVIDER
# Choose: groq | sambanova | openrouter | bitnet | ollama | openai | anthropic
#
#   groq        — Groq Cloud LPU (ultra-fast sub-second responses, recommended default)
#   sambanova   — SambaNova Cloud (SN40L high-speed inference)
#   openrouter  — cheap pay-per-token cloud (200+ models)
#   bitnet      — Alamia Connect Cloud
#   ollama      — free, runs locally (requires local GPU/CPU)
#   openai      — direct OpenAI billing
#   anthropic   — direct Anthropic billing
# ─────────────────────────────────────────────
AI_PROVIDER=groq

# ── Groq LPU (Ultra-Fast Cloud - Recommended) ─
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=qwen/qwen3.8-27b
GROQ_ORCHESTRATOR_MODEL=qwen/qwen3.8-27b
GROQ_VISA_MODEL=qwen/qwen3.8-27b
GROQ_APPOINTMENTS_MODEL=qwen/qwen3.8-27b

# ── SambaNova Cloud ───────────────────────────
SAMBANOVA_API_KEY=
SAMBANOVA_DEFAULT_MODEL=Meta-Llama-3.3-70B-Instruct

# ── OpenRouter ────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=https://kamalexpress.com
OPENROUTER_SITE_NAME=Kamal Express
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini

# ── BitNet (Alamia Connect Cloud) ─────────────
BITNET_SERVER_URL=https://ai.alamiaconnect.com/v1
BITNET_API_KEY=51129693340

# Model assignments — all are cheap/mid-tier; no frontier models needed.
# Costs are approximate per 1M tokens (blended input+output):
#   meta-llama/llama-3.1-8b-instruct   ≈ $0.06  — orchestrator triage
#   openai/gpt-4o-mini                 ≈ $0.15  — visa & appointments
#   mistralai/mistral-7b-instruct      ≈ $0.06  — lightweight fallback
#   anthropic/claude-3-haiku-20240307  ≈ $0.25  — best conversational quality
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
OPENROUTER_ORCHESTRATOR_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_VISA_MODEL=openai/gpt-4o-mini
OPENROUTER_APPOINTMENTS_MODEL=openai/gpt-4o-mini

# ── Ollama (local) ────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# Agent-level model overrides (all default to OLLAMA_DEFAULT_MODEL if unset)
OLLAMA_DEFAULT_MODEL=qwen2.5:7b
OLLAMA_ORCHESTRATOR_MODEL=gemma3:1b-it-qat
OLLAMA_VISA_MODEL=qwen2.5:7b
OLLAMA_APPOINTMENTS_MODEL=qwen3.5:4b

# ── OpenAI (cloud fallback) ───────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_ORCHESTRATOR_MODEL=gpt-4o-mini
OPENAI_VISA_MODEL=gpt-4o
OPENAI_APPOINTMENTS_MODEL=gpt-4o-mini

# ── Anthropic (cloud fallback) ────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_VISA_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_APPOINTMENTS_MODEL=claude-3-5-haiku-20241022

# ─────────────────────────────────────────────
# CAPTCHA SOLVING
# Provider: 2captcha | capsolver | anticaptcha | none
# ─────────────────────────────────────────────
CAPTCHA_PROVIDER=2captcha
CAPTCHA_API_KEY=
CAPTCHA_TIMEOUT=120
CAPTCHA_RETRY_ATTEMPTS=3

# ─────────────────────────────────────────────
# PROXY CONFIGURATION
# Provider: none | static | rotating | brightdata | oxylabs | smartproxy
# ─────────────────────────────────────────────
PROXY_PROVIDER=none
PROXY_STATIC_URL=                        # e.g. http://user:pass@host:port
PROXY_ROTATE_ENDPOINT=                   # rotating proxy gateway URL
PROXY_USERNAME=
PROXY_PASSWORD=
PROXY_COUNTRY=PK                         # ISO country for geo-targeted proxies

# BrightData (Luminati) specifics
BRIGHTDATA_ZONE=
BRIGHTDATA_HOST=brd.superproxy.io
BRIGHTDATA_PORT=22225

# ─────────────────────────────────────────────
# BROWSER AUTOMATION
#
# BROWSER_MODE options:
#   cdp   (recommended) — attach to your running Chrome via Chrome DevTools
#                         Protocol. Reuses your real profile, cookies, and
#                         login sessions. Chrome must be running with:
#                         --remote-debugging-port=9222
#                         Launch helper: python -m agents.appointments.browser
#
#   local (fallback)    — Playwright launches its own headless Chromium.
#                         Used when no system Chrome is available.
# ─────────────────────────────────────────────
BROWSER_MODE=cdp
BROWSER_CDP_URL=ws://localhost:9222          # use ws://host.docker.internal:9222 from Docker
BROWSER_CHROME_PROFILE=Default              # Chrome profile name (Default, Profile 1, etc.)

# Local mode settings (only used when BROWSER_MODE=local)
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
BROWSER_SLOW_MO_MS=0                        # ms delay between actions (0=fast, 100+=debug)
BROWSER_USER_DATA_DIR=./browser_profiles    # cookie persistence for local mode

# ─────────────────────────────────────────────
# API SERVER
# ─────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# ─────────────────────────────────────────────
# RAG / VECTOR STORE
# ─────────────────────────────────────────────
CHROMA_PERSIST_DIR=./rag/chroma_db
EMBED_MODEL=bge-m3:latest
EMBED_BASE_URL=http://localhost:11434/v1

# ─────────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────────
LOG_LEVEL=INFO
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=kamal-express

# ─────────────────────────────────────────────
# AUTHENTICATION & ROLE-BASED ACCESS CONTROL (RBAC)
# ─────────────────────────────────────────────
AUTH_ENABLED=true
AUTH_DEFAULT_ADMIN_USERNAME=admin
AUTH_DEFAULT_ADMIN_PASSWORD=KamalAdmin2026!
AUTH_DEFAULT_STAFF_USERNAME=staff
AUTH_DEFAULT_STAFF_PASSWORD=KamalStaff2026!
AUTH_SESSION_EXPIRE_DAYS=7
AUTH_WEBHOOK_SECRET=                             # Optional secret header for SMS OTP forwarder (X-Webhook-Secret)

