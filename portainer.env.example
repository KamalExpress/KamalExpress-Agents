# ─────────────────────────────────────────────────────────────────────────────
# Kamal Express AI Platform — Portainer Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# In Portainer:
# 1. Open your Stack -> Environment variables -> Switch to "Advanced mode".
# 2. Paste this block and fill in your private API keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── API Server ──
API_HOST=0.0.0.0
API_PORT=8080
API_RELOAD=false

# ── AI Provider Selection ──
# Choose: groq | sambanova | bitnet | openrouter | openai | anthropic
AI_PROVIDER=groq

# ── Groq Cloud (Ultra-Fast Cloud LPU - Recommended) ──
GROQ_API_KEY=your_groq_api_key_here
GROQ_DEFAULT_MODEL=qwen/qwen3.8-27b

# ── SambaNova Cloud (Alternative) ──
SAMBANOVA_API_KEY=
SAMBANOVA_DEFAULT_MODEL=Meta-Llama-3.3-70B-Instruct

# ── OpenRouter (Alternative) ──
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini

# ── BitNet (Alamia Connect Cloud) ──
BITNET_SERVER_URL=https://ai.alamiaconnect.com/v1
BITNET_API_KEY=51129693340

# ── Authentication & Role-Based Access Control (RBAC) ──
AUTH_ENABLED=true
AUTH_DEFAULT_ADMIN_USERNAME=admin
AUTH_DEFAULT_ADMIN_PASSWORD=KamalAdmin2026!
AUTH_DEFAULT_STAFF_USERNAME=staff
AUTH_DEFAULT_STAFF_PASSWORD=KamalStaff2026!
AUTH_SESSION_EXPIRE_DAYS=7
AUTH_WEBHOOK_SECRET=

# ── Captcha Solving Provider (none | 2captcha | capsolver) ──
CAPTCHA_PROVIDER=none
CAPTCHA_API_KEY=

# ── Browser Automation Mode (Headless on VPS) ──
BROWSER_MODE=local
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000

# ── Logging ──
LOG_LEVEL=INFO
